# Copy to .env for local development. Values here match infra/docker-compose.yml.

# App DB traffic goes through PgBouncer (transaction pooling), as the restricted
# app_runtime role — NOT the migration/owner role, so RLS policies actually apply.
DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:6433/saaserp"
# Prisma migrations need a direct (non-pooled) connection for DDL, as the owner role.
DIRECT_URL="postgresql://saaserp:saaserp_dev_password@localhost:5433/saaserp?schema=public"

MONGO_URL="mongodb://saaserp:saaserp_dev_password@localhost:27017/saaserp_audit?authSource=admin"

VALKEY_URL="redis://localhost:6380"

MINIO_ENDPOINT="localhost"
MINIO_PORT="9010"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="saaserp"
MINIO_SECRET_KEY="saaserp_dev_password"
MINIO_BUCKET="saas-erp-documents"

# Zitadel issuer the API verifies tokens against (JWKS is fetched from <issuer>/.well-known/openid-configuration).
ZITADEL_ISSUER="http://localhost:8081"
# The Project ID interns create manually in the Zitadel console on first setup — see
# docs/onboarding/GETTING_STARTED.md. Used to check the audience claim on incoming tokens.
ZITADEL_PROJECT_ID=""

OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

PORT="3000"
