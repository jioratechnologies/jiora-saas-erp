// Single source of truth for the database. See docs/adr/0001-multi-tenancy-shared-schema-rls.md
// for why this is one shared schema with tenant_id + Row-Level Security, not one schema per tenant.
//
// DATABASE_URL points at PgBouncer (transaction pooling) — used by the app at runtime.
// DIRECT_URL points straight at Postgres — used only by `prisma migrate` for DDL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A tenant = one client organisation running on the platform (e.g. Sachhi Saheli).
model Tenant {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  customDomain  String?   @unique @map("custom_domain")
  primaryColor  String    @default("#1F4E78") @map("primary_color")
  logoUrl       String?   @map("logo_url")
  showPoweredBy Boolean   @default(true) @map("show_powered_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  suspendedAt   DateTime? @map("suspended_at")

  workingDaysPerMonth Int   @default(22) @map("working_days_per_month")
  workHoursPerDay     Float @default(8) @map("work_hours_per_day")
  salarySplit         Json  @default("{\"basic\":50,\"hra\":25,\"other\":25}") @map("salary_split")

  users           User[]
  departments     Department[]
  designations    Designation[]
  roles           Role[]
  persons         Person[]
  personDocuments PersonDocument[]
  attendances     Attendance[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  holidays        Holiday[]

  salaryComponents          SalaryComponent[]
  salaryStructures          SalaryStructure[]
  employeeSalaryAssignments EmployeeSalaryAssignment[]
  payrollRuns               PayrollRun[]
  payslips                  Payslip[]
  payrollAdjustments        PayrollAdjustment[]
  expenseClaims             ExpenseClaim[]
  salaryAdvances            SalaryAdvance[]
  salaryRevisions           SalaryRevision[]

  @@map("tenants")
}

/// A department within one tenant's organisation (e.g. "Programme", "Finance").
model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users   User[]
  persons Person[]

  @@unique([tenantId, name])
  @@map("departments")
}

/// A designation/job title within one tenant (e.g. "Programme Officer").
model Designation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users   User[]
  persons Person[]
  role    Role?

  @@unique([tenantId, name])
  @@map("designations")
}

/// A person who can log in. tenantId is null for platform users (super_admin/developer/maintainer).
/// Identity (email, password, MFA) lives in Zitadel — this row is the app-side profile + role
/// assignment, linked back to Zitadel by zitadelSubjectId (the OIDC "sub" claim).
///
/// zitadelSubjectId is null between "invited" and "claimed": Admin invites a
/// user by email (no Zitadel account required yet); the row is claimed —
/// zitadelSubjectId filled in — the first time that email successfully logs
/// in via Zitadel. Postgres allows multiple NULLs under a UNIQUE constraint,
/// so many pending invites can coexist. See UsersService.claimInvite.
model User {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  zitadelSubjectId String?   @unique @map("zitadel_subject_id")
  email            String
  displayName      String    @map("display_name")
  phone            String?
  departmentId     String?   @map("department_id")
  designationId    String?   @map("designation_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  deactivatedAt    DateTime? @map("deactivated_at")
  avatarUrl        String?   @map("avatar_url")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  roles       UserRole[]
  person      Person?

  @@unique([tenantId, email])
  @@map("users")
}

/// A role: either a platform role (tenantId null — super_admin/developer/maintainer) or a
/// tenant-scoped role (the seeded, protected "admin" owner role, or a custom role the tenant's
/// admin built via the Role Builder).
model Role {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  name          String
  isProtected   Boolean  @default(false) @map("is_protected")
  /// Set when this role is the access profile of a designation.
  designationId String?  @unique @map("designation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designation Designation?     @relation(fields: [designationId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// One permission grant on a role. `permissionKey` references the static catalog in
/// packages/permissions (not a DB table — the catalog is code, not data, so it ships with a
/// deploy rather than needing a data migration to add a new permission).
model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// A user's assignment to a role. A user can hold more than one role.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

// ==========================================
// Phase 2: HR Core Enums & Models
// ==========================================

enum PersonType {
  EMPLOYEE
  VOLUNTEER
}

enum PersonStatus {
  JOINED
  PROBATION
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum DocumentCategory {
  KYC
  RESUME
  JOINING_LETTER
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceMode {
  OFFICE
  REMOTE
  FIELD
  ON_DUTY
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum LeaveApplicability {
  EMPLOYEE_ONLY
  ALL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Unified Person Master for both Employees and Volunteers
model Person {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  userId           String?      @unique @map("user_id")
  personType       PersonType   @default(EMPLOYEE) @map("person_type")
  status           PersonStatus @default(ACTIVE)
  firstName        String       @map("first_name")
  middleName       String?      @map("middle_name")
  lastName         String       @map("last_name")
  email            String
  phone            String?
  altPhone         String?      @map("alt_phone")
  gender           String?
  dob              DateTime?
  address          String?
  currentAddress   String?      @map("current_address")
  permanentAddress String?      @map("permanent_address")
  emergencyContact String?      @map("emergency_contact")
  avatarUrl        String?      @map("avatar_url")

  departmentId  String? @map("department_id")
  designationId String? @map("designation_id")
  managerId     String? @map("manager_id")

  joiningDate      DateTime  @default(now()) @map("joining_date")
  confirmationDate DateTime? @map("confirmation_date")
  exitDate         DateTime? @map("exit_date")
  exitReason       String?   @map("exit_reason")
  exitChecklist    Json?     @default("{}") @map("exit_checklist")
  panNumber        String?   @map("pan_number")
  aadhaarNumber    String?   @map("aadhaar_number")
  bankAccount      String?   @map("bank_account")
  bankIfsc         String?   @map("bank_ifsc")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager        Person?          @relation("ReportingHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Person[]         @relation("ReportingHierarchy")
  documents      PersonDocument[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  approvedLeaves LeaveRequest[]   @relation("LeaveApprover")

  salaryAssignment   EmployeeSalaryAssignment?
  payslips           Payslip[]
  payrollAdjustments PayrollAdjustment[]
  submittedClaims    ExpenseClaim[]            @relation("ClaimSubmitter")
  approvedClaims     ExpenseClaim[]            @relation("ClaimApprover")
  salaryAdvances     SalaryAdvance[]           @relation("AdvanceRequester")
  approvedAdvances   SalaryAdvance[]           @relation("AdvanceApprover")
  salaryRevisions    SalaryRevision[]

  @@unique([tenantId, email])
  @@index([tenantId, personType, status])
  @@index([tenantId, status, firstName, id], map: "idx_persons_tenant_id_status_first_name_id")
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, managerId])
  @@map("persons")
}

model PersonDocument {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  personId        String           @map("person_id")
  name            String
  fileKey         String           @map("file_key")
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  category        DocumentCategory @default(OTHER)
  documentNumber  String?          @map("document_number")
  status          DocumentStatus   @default(PENDING)
  rejectionReason String?          @map("rejection_reason")
  verifiedAt      DateTime?        @map("verified_at")
  verifiedBy      String?          @map("verified_by")
  uploadedAt      DateTime         @default(now()) @map("uploaded_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId, category])
  @@index([tenantId, status])
  @@map("person_documents")
}

model Attendance {
  id                   String           @id @default(uuid())
  tenantId             String           @map("tenant_id")
  personId             String           @map("person_id")
  date                 DateTime         @db.Date
  checkInTime          DateTime         @map("check_in_time")
  checkOutTime         DateTime?        @map("check_out_time")
  mode                 AttendanceMode   @default(OFFICE)
  latitude             Float?
  longitude            Float?
  locationName         String?          @map("location_name")
  notes                String?
  status               AttendanceStatus @default(PRESENT)
  offlineAttendanceId  String?          @map("offline_attendance_id")
  verificationMode     String           @default("ONLINE") @map("verification_mode")
  verificationStatus   String           @default("VERIFIED") @map("verification_status")
  syncStatus           String           @default("DIRECT") @map("sync_status")
  selfieUrl            String?          @map("selfie_url")
  deviceSignals        Json?            @map("device_signals")
  accuracyMeters       Float?           @map("accuracy_meters")
  regularizedBy        String?          @map("regularized_by")
  regularizationReason String?          @map("regularization_reason")
  regularizedAt        DateTime?        @map("regularized_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId, date])
  @@unique([tenantId, offlineAttendanceId])
  @@index([tenantId, date, status])
  @@index([tenantId, personId, checkInTime])
  @@index([tenantId, date(sort: Desc), checkInTime(sort: Desc)], map: "idx_attendances_tenant_id_date_check_in_time")
  @@map("attendances")
}

model LeaveType {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  name         String
  code         String
  annualQuota  Int                @default(12) @map("annual_quota")
  applicableTo LeaveApplicability @default(ALL) @map("applicable_to")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("leave_types")
}

model LeaveRequest {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  personId            String      @map("person_id")
  leaveTypeId         String      @map("leave_type_id")
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime    @map("end_date") @db.Date
  daysCount           Int         @default(1) @map("days_count")
  reason              String
  supportingDocuments Json?       @default("[]") @map("supporting_documents")
  status              LeaveStatus @default(PENDING)
  approverId          String?     @map("approver_id")
  decisionNotes       String?     @map("decision_notes")
  decidedAt           DateTime?   @map("decided_at")
  createdAt           DateTime    @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approver  Person?   @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId, approverId, status])
  @@index([tenantId, personId, status])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_leave_requests_tenant_id_created_at")
  @@map("leave_requests")
}

model Holiday {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  date       DateTime @db.Date
  isOptional Boolean  @default(false) @map("is_optional")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, name])
  @@index([tenantId, date])
  @@map("holidays")
}

// ==========================================
// Phase 3: Payroll, Claims & Compensation
// ==========================================

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

model SalaryComponent {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  name        String
  code        String
  type        SalaryComponentType @default(EARNING)
  isTaxable   Boolean             @default(true) @map("is_taxable")
  isStatutory Boolean             @default(false) @map("is_statutory")
  description String?
  createdAt   DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("salary_components")
}

model SalaryStructure {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  items       Json     @default("[]") // Array of { componentCode, calculationType: PERCENTAGE_OF_BASIC | FIXED, value: number }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments EmployeeSalaryAssignment[]

  @@unique([tenantId, name])
  @@map("salary_structures")
}

model EmployeeSalaryAssignment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  personId          String   @unique @map("person_id")
  salaryStructureId String?  @map("salary_structure_id")
  baseGross         Float    @default(0) @map("base_gross")
  ctc               Float    @default(0)
  customItems       Json?    @default("[]") @map("custom_items")
  effectiveFrom     DateTime @default(now()) @map("effective_from") @db.Date
  paymentMode       String   @default("BANK_TRANSFER") @map("payment_mode")
  bankAccount       String?  @map("bank_account")
  bankIfsc          String?  @map("bank_ifsc")
  panNumber         String?  @map("pan_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person          Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  @@index([tenantId, salaryStructureId])
  @@map("employee_salary_assignments")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  DISBURSED
}

model PayrollRun {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  year                Int
  month               Int
  title               String
  status              PayrollRunStatus @default(DRAFT)
  totalGross          Float            @default(0) @map("total_gross")
  totalDeductions     Float            @default(0) @map("total_deductions")
  totalNet            Float            @default(0) @map("total_net")
  processedStaffCount Int              @default(0) @map("processed_staff_count")
  approvedBy          String?          @map("approved_by")
  approvedAt          DateTime?        @map("approved_at")
  disbursedAt         DateTime?        @map("disbursed_at")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

model Payslip {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  payrollRunId     String   @map("payroll_run_id")
  personId         String   @map("person_id")
  year             Int
  month            Int
  totalWorkingDays Int      @default(30) @map("total_working_days")
  presentDays      Float    @default(30) @map("present_days")
  lopDays          Float    @default(0) @map("lop_days")
  earnings         Json     @default("[]") // Array of { code, name, amount }
  deductions       Json     @default("[]") // Array of { code, name, amount }
  grossPay         Float    @default(0) @map("gross_pay")
  totalDeductions  Float    @default(0) @map("total_deductions")
  netPay           Float    @default(0) @map("net_pay")
  calcSummary      Json?    @map("calc_summary") // { expectedDays, paidDays, unpaidDays, perDayRate, lopAmount, earnedGross, baseGross }
  paymentStatus    String   @default("PENDING") @map("payment_status")
  paymentReference String?  @map("payment_reference")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, payrollRunId, personId])
  @@index([tenantId, personId, year, month])
  @@map("payslips")
}

enum ExpenseClaimCategory {
  TRAVEL
  LODGING
  FOOD
  SUPPLIES
  COMMUNICATION
  OFFICIAL_MEETING
  OTHER
}

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SETTLED
}

model ExpenseClaim {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  personId            String               @map("person_id")
  title               String
  category            ExpenseClaimCategory @default(TRAVEL)
  amount              Float
  expenseDate         DateTime             @map("expense_date") @db.Date
  description         String?
  receiptUrls         Json?                @default("[]") @map("receipt_urls")
  status              ExpenseClaimStatus   @default(SUBMITTED)
  approverId          String?              @map("approver_id")
  decisionNotes       String?              @map("decision_notes")
  decidedAt           DateTime?            @map("decided_at")
  settledAt           DateTime?            @map("settled_at")
  settlementReference String?              @map("settlement_reference")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person   Person  @relation("ClaimSubmitter", fields: [personId], references: [id], onDelete: Cascade)
  approver Person? @relation("ClaimApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId, personId, status])
  @@index([tenantId, approverId, status])
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_expense_claims_tenant_id_status_created_at")
  @@map("expense_claims")
}

enum SalaryAdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  RECOVERING
  RECOVERED
}

model SalaryAdvance {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  personId         String              @map("person_id")
  amountRequested  Float               @map("amount_requested")
  amountApproved   Float?              @map("amount_approved")
  reason           String
  tenureMonths     Int                 @default(1) @map("tenure_months")
  monthlyDeduction Float               @default(0) @map("monthly_deduction")
  amountRecovered  Float               @default(0) @map("amount_recovered")
  status           SalaryAdvanceStatus @default(PENDING)
  approverId       String?             @map("approver_id")
  decisionNotes    String?             @map("decision_notes")
  decidedAt        DateTime?           @map("decided_at")
  disbursedAt      DateTime?           @map("disbursed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person   Person  @relation("AdvanceRequester", fields: [personId], references: [id], onDelete: Cascade)
  approver Person? @relation("AdvanceApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId, personId, status])
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_salary_advances_tenant_id_status_created_at")
  @@map("salary_advances")
}

model SalaryRevision {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  personId         String   @map("person_id")
  oldGross         Float?   @map("old_gross")
  newGross         Float    @map("new_gross")
  oldDesignationId String?  @map("old_designation_id")
  newDesignationId String?  @map("new_designation_id")
  effectiveDate    DateTime @map("effective_date") @db.Date
  remarks          String?
  promotedBy       String?  @map("promoted_by")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId, effectiveDate])
  @@map("salary_revisions")
}

enum PayrollAdjustmentType {
  BONUS
  ALLOWANCE
  DEDUCTION
}

model PayrollAdjustment {
  id        String                @id @default(uuid())
  tenantId  String                @map("tenant_id")
  personId  String                @map("person_id")
  year      Int
  month     Int
  type      PayrollAdjustmentType
  amount    Float
  reason    String
  createdBy String?               @map("created_by")
  createdAt DateTime              @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, year, month])
  @@index([tenantId, personId, year, month])
  @@map("payroll_adjustments")
}
